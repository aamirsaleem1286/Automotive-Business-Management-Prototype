{
  "name": "autoforge",
  "version": "1.0.0",
  "private": true,
  "description": "AutoForge - automotive business operating system with SQLite persistence, secure admin dashboard and 3D experience.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate --schema prisma/schema.postgres.prisma && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:studio": "prisma studio",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "seed:postgres": "prisma generate --schema prisma/schema.postgres.prisma && tsx scripts/seed.ts --reset"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@hookform/resolvers": "6.0.2",
    "@prisma/client": "6.19.0",
    "@react-three/fiber": "9.8.2",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "jose": "6.2.14",
    "lucide-react": "1.66.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "autoprefixer": "10.6.2",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.32",
    "prisma": "6.19.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
